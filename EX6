#include <stdio.h>
#include <stdlib.h>

int cqueue[5] = {-1, -1, -1, -1, -1};
int rear = -1;
int front = 0;

void enqueue(int);
void dequeue(void);
void print(void);

int main()
{
    int ch, x;

    while (1)
    {
        printf("\n1.Enqueue\t2.Dequeue\t3.Print Queue\t4.Exit\n");
        printf("Enter your Choice\n");
        scanf("%d", &ch);

        switch (ch)
        {
            case 1:
                printf("Enter the element to be inserted\n");
                scanf("%d", &x);
                printf("Before Enqueue-");
                print();
                enqueue(x);
                break;

            case 2:
                printf("Before Dequeue-");
                print();
                dequeue();
                break;

            case 3:
                print();
                break;

            case 4:
                exit(0);

            default:
                printf("Invalid choice\n");
        }
    }

    return 0;
}

void enqueue(int x)
{
    int nextRear = (rear + 1) % 5;

    if (nextRear == front && cqueue[front] != -1)
    {
        printf("\nQueue is full\n");
        return;
    }

    rear = nextRear;
    cqueue[rear] = x;

    printf("\nAfter Enqueue- rear = %d\n", rear);
    print();
}

void dequeue(void)
{
    int del;

    if (cqueue[front] == -1)
    {
        printf("\nCircular queue is empty\n");
        return;
    }

    del = cqueue[front];
    cqueue[front] = -1;
    front = (front + 1) % 5;

    if (front == (rear + 1) % 5)
    {
        rear = front - 1;
        if (rear < 0)
            rear = 4;
    }

    printf("\nThe deleted item is %d\n", del);
    printf("After Dequeue front = %d\n", front);
    print();
}

void print(void)
{
    int i;

    printf("\nQueue Contents are\n");

    if (cqueue[front] == -1)
    {
        printf("Empty\n");
        return;
    }

    i = front;

    while (1)
    {
        printf("%d\t", cqueue[i]);

        if (i == rear)
            break;

        i = (i + 1) % 5;
    }

    printf("\n");
}


