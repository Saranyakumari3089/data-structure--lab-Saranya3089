#include <stdio.h>
#include <stdlib.h>

struct cnode
{
    int data;
    struct cnode *next;
};

void insertion(struct cnode *, int, int);
void deletion(struct cnode *, int);
struct cnode *find(struct cnode *, int);
struct cnode *findprevious(struct cnode *, int);
void print(struct cnode *);

int main()
{
    struct cnode *head, *p;
    int ch, x, m;

    /* Creation of header node */
    head = (struct cnode *)malloc(sizeof(struct cnode));

    head->data = -1;
    head->next = head;

    while (1)
    {
        printf("\n1.Insertion 2.Deletion 3.Find 4.Find Previous 5.Print 6.Exit\n");
        printf("Enter the choice for operations\n");
        scanf("%d", &ch);

        switch (ch)
        {
            case 1:
                printf("Enter the element to be inserted\n");
                scanf("%d", &x);

                printf("Enter the element after which new to be inserted\n");
                scanf("%d", &m);

                printf("Before Insertion\n");
                print(head);

                insertion(head, x, m);

                printf("After Insertion\n");
                print(head);
                break;

            case 2:
                printf("Enter the element to be deleted\n");
                scanf("%d", &x);

                printf("Before Deletion\n");
                print(head);

                deletion(head, x);

                printf("After Deletion\n");
                print(head);
                break;

            case 3:
                printf("Enter the element to be searched\n");
                scanf("%d", &x);

                p = find(head, x);

                if (p != NULL)
                    printf("The element is present in the list\n");
                else
                    printf("The element is not present\n");
                break;

            case 4:
                printf("Enter the element to be searched\n");
                scanf("%d", &x);

                p = findprevious(head, x);

                if (p != NULL)
                    printf("The previous node of the element is present\n");
                else
                    printf("The element is not present\n");
                break;

            case 5:
                printf("The elements in the linked list are\n");
                print(head);
                break;

            case 6:
                free(head);
                return 0;

            default:
                printf("Invalid choice\n");
        }
    }
}

void insertion(struct cnode *head, int x, int m)
{
    struct cnode *newnode, *p;

    newnode = (struct cnode *)malloc(sizeof(struct cnode));
    newnode->data = x;

    if (m == -1)
    {
        newnode->next = head->next;
        head->next = newnode;
    }
    else
    {
        p = head->next;

        while (p != head)
        {
            if (m == p->data)
            {
                newnode->next = p->next;
                p->next = newnode;
                return;
            }

            p = p->next;
        }

        printf("Element not found\n");
        free(newnode);
    }
}

void deletion(struct cnode *head, int x)
{
    struct cnode *p, *pre;

    pre = head;
    p = head->next;

    while (p != head)
    {
        if (x == p->data)
        {
            pre->next = p->next;
            free(p);
            return;
        }

        pre = p;
        p = p->next;
    }

    printf("Element not found\n");
}

struct cnode *find(struct cnode *head, int x)
{
    struct cnode *p;

    p = head->next;

    while (p != head)
    {
        if (x == p->data)
            return p;

        p = p->next;
    }

    return NULL;
}

struct cnode *findprevious(struct cnode *head, int x)
{
    struct cnode *p, *pre;

    pre = head;
    p = head->next;

    while (p != head)
    {
        if (x == p->data)
            return pre;

        pre = p;
        p = p->next;
    }

    return NULL;
}

void print(struct cnode *head)
{
    struct cnode *p;

    p = head->next;

    while (p != head)
    {
        printf("%d-->", p->data);
        p = p->next;
    }

    printf("\n");
}



